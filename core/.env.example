# core/.env にコピーして使う（.env は Git に入れない）。空のままでも動く（そのときは試し運転）。
# センサー中継の記録の場所（読み取り専用で見る）
SENSOR_LOG_DIR=../Logs/sensor_bridge
# 書き出しフォルダ（コンテナが要約を置く場所）。Google Drive へは PC 側の psoc6_key.py --drive-folder が写す
EXPORT_FOLDER=../Logs/drive_out
# 店の名前（共有文と記録に入る）
STORE_NAME=ロボもり デモ店
# Linux で書き出しフォルダに書けないときだけ（例: 1000:1000）。Windows / Mac の Docker Desktop では要らない
# DOOR2_USER=1000:1000
# 監視 AI の学ぶ時間と、戻す提案までの時間（秒）。発表では短くする
HUB_LEARN_SECONDS=10
HUB_RELAX_AFTER=60
# 扉 2 の相手。空なら送らない（試し運転）
GEMINI_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# 書き込む先の PDS。空なら bsky.social。社内の PDS を立てたら、その住所（例: https://pds.example.internal）
BLUESKY_SERVICE=
# 返信を読む先。空なら public.api.bsky.app
BLUESKY_APPVIEW=
# 記録の種類（NSID）。空なら名前の入らない internal.robomori.report。公開の名前空間で使うときは、自分のドメインを逆にした名前
REPORT_COLLECTION=
# 仮想 VPN の会社のアカウント（handle:password をカンマで）。core\host\bluesky_setup.ps1 -Vpn がランダムなパスワードで書く
VPN_PDS_ACCOUNTS=
# 仮想 VPN（docker compose --profile vpn）の社内 PDS を使うときは、core\host\bluesky_setup.ps1 -Vpn がまとめて書く
# 扉 2 の出口が通す宛先（変えるときだけ。既定は Gemini と Bluesky の 3 つ）
# EGRESS_ALLOW=generativelanguage.googleapis.com,bsky.social,public.api.bsky.app
# 社内（VPN）だけで動かすとき: 社内の PDS だけを通す。例:
#   BLUESKY_SERVICE=https://pds.robomori.internal
#   EGRESS_ALLOW=pds.robomori.internal
#   EGRESS_INTERNAL=pds.robomori.internal
